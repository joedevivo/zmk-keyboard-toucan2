#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define KEYS_L 0 1 2 3 4  5  12 13 14 15 16 17  24 25 26 27 28 29  36 37 38 // left hand
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23  30 31 32 33 34 35  39 40 41 // right hand
#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q        &kp W       &kp E       &kp R        &kp T
                &kp LCTRL &hml LCTRL A &hml LALT S &hml LGUI D &hml LSHFT F &kp G
                &kp LSHFT &kp Z        &kp X       &kp C       &kp V        &kp B
                                                              &kp LGUI &mo 1 &kp BPSC

                   &kp Y &kp U  &kp I     &kp O   &kp P    &kp RET
                   &kp H &hmr RSHFT J  &hmr RGUI K     &hmr RALT L   &hmr RCTRL SEMI &kp SQT
                   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                   &kp SPACE &mo 2 &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TILDE   &kp EXCL       &kp AT &kp HASH &kp DLLR &kp PRCNT
                &trans      &trans         &trans &trans   &trans   &trans   
                &kp LSHFT   &studio_unlock &trans &trans   &trans   &trans   
                                       &kp LGUI     &trans       &kp SPACE   

                   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR  &kp RPAR &kp BSPC
                   &kp LEFT  &kp DOWN  &kp UP          &kp RIGHT &trans   &trans
                   &trans    &trans    &trans          &trans    &trans   &trans
                   &kp RET  &trans   &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp N1   &kp N2 &kp N3   &kp N4   &kp N5   
                &kp LCTRL &trans   &trans &trans   &trans   &trans   
                &kp LSHFT &trans   &trans &trans   &trans   &trans   
                                          &kp LGUI &trans   &kp SPACE

                   &kp N6    &kp N7    &kp N8   &kp N9   &kp N0   &kp BSPC
                   &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
                   &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE &kp TILDE
                   &kp RET   &trans    &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &mo TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11  
                &bt LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10
                                   &kp LGUI &mo NAV &kp SPACE

                   &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP &trans       &trans       &kp BSPC
                   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR  
                   &trans       &trans       &trans       &trans       &trans       &trans
                   &kp RET &mo 2 &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
